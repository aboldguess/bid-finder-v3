{
  "name": "bid-finder",
  "version": "4.0.0",
  "description": "Self-hosted tender and grant finder: watches public and private procurement portals, scores every opportunity against your firm, and alerts you.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.js serve",
    "serve": "node src/cli.js serve",
    "ingest": "node src/cli.js ingest",
    "digest": "node src/cli.js digest",
    "demo": "node scripts/demo.js",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.js\"",
    "check:sources": "node scripts/check-sources.js",
    "test:e2e": "node --test --test-reporter=spec \"test/e2e/*.e2e.js\""
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "cheerio": "^1.2.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.0",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "playwright": "1.63.0"
  },
  "bin": {
    "bidfinder": "src/cli.js"
  }
}

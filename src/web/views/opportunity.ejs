<%- include('partials/head', { title: opp.title }) %>
<p class="back"><a href="/feed">← Opportunities</a></p>
<article class="detail">
  <header class="detail-head">
    <span class="score big <%= fmt.band(match.score) %>" title="Fit score, out of 100"><%= match.score %></span>
    <div>
      <h1><%= opp.title %></h1>
      <p class="meta"><span class="tag <%= opp.type %>"><%= opp.type %></span><span><%= sourceNames[opp.source_key] || opp.source_key %></span><% if (opp.notice_type) { %><span><%= opp.notice_type %></span><% } %></p>
    </div>
  </header>
  <div class="detail-grid">
    <div>
      <dl class="facts">
        <% if (opp.funder) { %><dt><%= opp.type === 'grant' ? 'Funder' : 'Buyer' %></dt><dd><%= opp.funder %></dd><% } %>
        <% if (opp.award_text || opp.award_max) { %><dt><%= opp.type === 'grant' ? 'Award' : 'Value' %></dt><dd><%= opp.award_text || [opp.award_min && fmt.money(opp.award_min, opp.currency), opp.award_max && fmt.money(opp.award_max, opp.currency)].filter(Boolean).join(' to ') %></dd><% } %>
        <% if (opp.total_fund) { %><dt>Total fund</dt><dd><%= fmt.money(opp.total_fund, opp.currency) %></dd><% } %>
        <% if (opp.closes_at) { %><dt>Closes</dt><dd class="deadline <%= fmt.soon(opp.closes_at) ? 'soon' : '' %>"><%= fmt.dateTime(opp.closes_at) %> · <%= fmt.daysLeft(opp.closes_at) %></dd><% } %>
        <% if (opp.opens_at) { %><dt>Opens</dt><dd><%= fmt.dateTime(opp.opens_at) %></dd><% } %>
        <% if (opp.published_at) { %><dt>Published</dt><dd><%= fmt.date(opp.published_at) %></dd><% } %>
        <% if (opp.location || opp.country) { %><dt>Location</dt><dd><%= [opp.location, opp.country].filter(Boolean).join(' · ') %></dd><% } %>
        <% if (opp.status) { %><dt>Status</dt><dd><%= opp.status %></dd><% } %>
        <% if (opp.cpv_codes) { %><dt>CPV</dt><dd class="chips"><% opp.cpv_codes.split(' ').forEach(c => { %><a class="chip" href="/feed?view=all&cpv=<%= c %>"><%= c %></a><% }) %></dd><% } %>
        <% if (opp.eligibility) { %><dt><%= opp.type === 'grant' ? 'Who can apply' : 'Classification' %></dt><dd><%= opp.eligibility %></dd><% } %>
      </dl>
      <% if (opp.summary) { %><h2>Description</h2><p class="prose"><%= opp.summary %></p><% } %>
      <p class="row"><a class="button" href="<%= opp.url %>" rel="noopener noreferrer" target="_blank">Open the notice on <%= sourceNames[opp.source_key] || 'the source' %></a></p>
      <% if (also.length) { %>
        <p class="muted">Also published on: <% also.forEach((a, i) => { %><%= i ? ', ' : '' %><a href="<%= a.url %>" rel="noopener noreferrer" target="_blank"><%= sourceNames[a.source_key] || a.source_key %></a><% }) %></p>
      <% } %>
    </div>
    <aside>
      <% if (match.reasons.length) { %>
        <div class="panel"><h2>Why it scored <%= match.score %></h2><ul class="reasons vertical"><% match.reasons.forEach(r => { %><li><%= r %></li><% }) %></ul></div>
      <% } %>
      <form method="post" action="/o/<%= opp.id %>/state" class="stack panel">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="/o/<%= opp.id %>">
        <h2>Your bid</h2>
        <label>Pipeline stage
          <select name="stage">
            <option value="">Not in the pipeline</option>
            <% STAGES.forEach(s => { %><option value="<%= s %>" <%= state.stage === s ? 'selected' : '' %>><%= STAGE_LABELS[s] %></option><% }) %>
          </select>
        </label>
        <label>Team notes <textarea name="note" rows="5" placeholder="Partners, eligibility questions, bid or no-bid reasoning"><%= state.note || '' %></textarea></label>
        <div class="row">
          <button class="button small">Save</button>
          <button class="button small ghost" name="starred" value="<%= state.starred ? 0 : 1 %>"><%= state.starred ? 'Remove from shortlist' : 'Add to shortlist' %></button>
        </div>
      </form>
    </aside>
  </div>
</article>
<%- include('partials/foot') %>

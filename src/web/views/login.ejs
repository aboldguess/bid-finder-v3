<%- include('partials/head', { title: 'Sign in' }) %>
<section class="narrow panel">
  <h1>Sign in</h1>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/login" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Email <input type="email" name="email" required value="<%= email %>" autocomplete="email" autofocus></label>
    <label>Password <input type="password" name="password" required autocomplete="current-password"></label>
    <button class="button">Sign in</button>
  </form>
  <% if (canRegister) { %><p class="muted">First time here? <a href="/register">Create the first account</a></p>
  <% } else { %><p class="muted">Need an account? Ask your administrator for an invitation.</p><% } %>
</section>
<%- include('partials/foot') %>

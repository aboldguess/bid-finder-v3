<%- include('partials/head', { title: 'Account' }) %>
<section class="narrow wide">
  <h1>Account</h1>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <div class="panel">
    <h2>API tokens</h2>
    <p class="muted">Tokens let scripts and other tools read your opportunities through the <a href="/api">API</a>. A token acts as you.</p>
    <% if (newToken) { %>
      <div class="notice good"><strong>Copy this token now. It will not be shown again.</strong><code class="secret"><%= newToken %></code></div>
    <% } %>
    <ul class="list">
      <% tokens.forEach(t => { %>
        <li><span><strong><%= t.name %></strong> <code><%= t.prefix %>…</code> <span class="muted"><%= t.last_used_at ? 'last used ' + fmt.stamp(t.last_used_at) : 'never used' %></span></span>
          <form method="post" action="/account/tokens/<%= t.id %>/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link danger">Revoke</button></form></li>
      <% }) %>
      <% if (!tokens.length) { %><li class="muted">No tokens yet.</li><% } %>
    </ul>
    <form method="post" action="/account/tokens" class="row">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Name for a new token <input name="name" placeholder="e.g. CRM sync" required></label>
      <button class="button small">Create token</button>
    </form>
  </div>
  <div class="panel">
    <h2>Change password</h2>
    <form method="post" action="/account/password" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Current password <input type="password" name="current" required autocomplete="current-password"></label>
      <label>New password <input type="password" name="password" required minlength="10" autocomplete="new-password"><small>At least 10 characters. Other devices will be signed out.</small></label>
      <button class="button small">Change password</button>
    </form>
  </div>
  <div class="panel" id="your-data">
    <h2>Your organisation's data</h2>
    <p class="muted">Download everything <%= org.name %> has in Bid Finder as a JSON file: profile, members, saved searches, shortlist, notes and pipeline, digests and private portals. Passwords, webhook addresses and API keys are left out.</p>
    <a class="button small ghost" href="/account/export" download>Download our data</a>
  </div>
  <div class="panel delete-panel" id="delete">
    <h2>Delete</h2>
    <form method="post" action="/account/delete" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (org.role === 'owner') { %>
        <fieldset>
          <legend>What to delete</legend>
          <label class="inline"><input type="radio" name="scope" value="org" checked> <span>The whole organisation, <strong><%= org.name %></strong>: everyone's access, profile, searches, shortlist, pipeline and private portals<%= locals.hosted ? ', and any subscription is cancelled' : '' %></span></label>
          <label class="inline"><input type="radio" name="scope" value="me"> <span>Only my account (another owner keeps the organisation)</span></label>
        </fieldset>
        <label>To delete the organisation, type its name <input name="confirm" autocomplete="off" placeholder="<%= org.name %>"></label>
      <% } else { %>
        <input type="hidden" name="scope" value="me">
        <p>Deleting your account removes your name and email address. <%= org.name %> keeps its searches, shortlist and pipeline.</p>
      <% } %>
      <label>Your password <input type="password" name="password" required autocomplete="current-password"></label>
      <p class="muted">This cannot be undone. Download your data first if you might want it.</p>
      <p><button class="button danger">Delete permanently</button></p>
    </form>
  </div>
</section>
<%- include('partials/foot') %>

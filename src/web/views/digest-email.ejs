<%# Email HTML: inline styles only, since mail clients ignore stylesheets. %>
<div style="font-family:Arial,Helvetica,sans-serif;max-width:640px;margin:0 auto;color:#1f2937">
  <h1 style="font-size:20px;margin:0 0 4px">New opportunities for <%= org.name %></h1>
  <p style="color:#6b7280;margin:0 0 20px"><%= items.length %> new since your last digest, best matches first.</p>
  <% items.forEach(o => { %>
    <div style="border:1px solid #e5e7eb;border-radius:8px;padding:12px 14px;margin:0 0 12px">
      <div style="font-size:12px;color:#6b7280;text-transform:uppercase;letter-spacing:.04em">Fit <%= o.match.score %> · <%= o.type %><% if (o.closes_at) { %> · closes <%= new Date(o.closes_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/London' }) %><% } %></div>
      <a href="<%= baseUrl %>/o/<%= o.id %>" style="font-size:16px;font-weight:bold;color:#1d4ed8;text-decoration:none"><%= o.title %></a>
      <div style="font-size:13px;color:#374151;margin-top:4px"><%= o.funder %><% if (o.award_text) { %> · <%= o.award_text %><% } %></div>
      <% if (o.match.reasons.length) { %><div style="font-size:13px;color:#047857;margin-top:6px"><%= o.match.reasons.join(' · ') %></div><% } %>
    </div>
  <% }) %>
  <p style="font-size:12px;color:#6b7280">Change what you receive on your <a href="<%= baseUrl %>/profile">profile page</a>.</p>
</div>

<%- include('partials/head', { title: 'Opportunities' }) %>
<div class="pagehead"><h1>Opportunities</h1>
  <a class="button small ghost" href="/searches/new?<%= query %>">Save this search and get alerts</a>
</div>
<% if (profileEmpty) { %><p class="notice">Your feed is not personalised yet. <a href="/profile">Add keywords and CPV categories to your profile</a> and everything will be ranked by fit.</p><% } %>
<% if (ingesting) { %><p class="notice">Fetching the latest opportunities now. Refresh in a minute.</p><% } %>
<form class="filters" method="get" action="/feed">
  <input type="search" name="q" value="<%= filters.q %>" placeholder="Search titles, buyers and descriptions" aria-label="Search" class="f-q">
  <select name="view" aria-label="View">
    <% [['matches', 'Best matches'], ['all', 'Everything open'], ['starred', 'Shortlist'], ['pipeline', 'In the pipeline'], ['hidden', 'Hidden']].forEach(([v, label]) => { %>
      <option value="<%= v %>" <%= filters.view === v ? 'selected' : '' %>><%= label %></option>
    <% }) %>
  </select>
  <select name="type" aria-label="Type">
    <option value="">Tenders and grants</option>
    <option value="tender" <%= filters.type === 'tender' ? 'selected' : '' %>>Tenders only</option>
    <option value="grant" <%= filters.type === 'grant' ? 'selected' : '' %>>Grants only</option>
  </select>
  <select name="source" aria-label="Source">
    <option value="">All sources</option>
    <% Object.entries(sourceNames).forEach(([k, name]) => { %><option value="<%= k %>" <%= filters.source === k ? 'selected' : '' %>><%= name %></option><% }) %>
  </select>
  <input name="cpv" value="<%= filters.cpv %>" placeholder="CPV, e.g. 713, 42" aria-label="CPV codes" title="CPV code or its leading digits. Separate several with commas.">
  <input name="min_value" value="<%= filters.min_value ?? '' %>" placeholder="Min value" inputmode="numeric" aria-label="Minimum value">
  <select name="sort" aria-label="Sort">
    <% [['score', 'Best fit first'], ['deadline', 'Closing soonest'], ['newest', 'Newest first'], ['value', 'Highest value']].forEach(([v, label]) => { %>
      <option value="<%= v %>" <%= filters.sort === v ? 'selected' : '' %>><%= label %></option>
    <% }) %>
  </select>
  <button class="button small">Apply</button>
</form>
<% if (filters.view === 'starred') { %>
  <div class="share">
    <% if (org.share_token) { %>
      <p>Shared shortlist: <a href="/s/<%= org.share_token %>">/s/<%= org.share_token %></a> (anyone with the link can view it)</p>
      <form method="post" action="/share"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="enable" value="0"><button class="link">Stop sharing</button></form>
    <% } else { %>
      <form method="post" action="/share"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="enable" value="1"><button class="button small ghost">Share this shortlist as a read-only page</button></form>
    <% } %>
  </div>
<% } %>
<p class="muted count"><%= total.toLocaleString('en-GB') %> <%= total === 1 ? 'opportunity' : 'opportunities' %><%= pages > 1 ? `, page ${page} of ${pages}` : '' %></p>
<div class="cards" data-csrf="<%= csrfToken %>">
  <% items.forEach(o => { %><%- include('partials/card', { o, interactive: true }) %><% }) %>
  <% if (!items.length) { %><p class="empty">Nothing here yet. Try "Everything open", or widen your profile.</p><% } %>
</div>
<% if (pages > 1) { %>
  <nav class="pager" aria-label="Pages">
    <% if (page > 1) { %><a class="button small ghost" href="/feed?<%= query %>&page=<%= page - 1 %>">Previous</a><% } %>
    <% if (page < pages) { %><a class="button small ghost" href="/feed?<%= query %>&page=<%= page + 1 %>">Next</a><% } %>
  </nav>
<% } %>
<%- include('partials/foot') %>

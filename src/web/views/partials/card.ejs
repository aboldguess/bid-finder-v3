<%# One opportunity in a list. Expects: o (row with .match), interactive %>
<article class="card <%= o.starred ? 'starred' : '' %>" data-id="<%= o.id %>">
  <span class="score <%= fmt.band(o.match.score) %>" title="Fit score, out of 100"><%= o.match.score %></span>
  <div class="card-body">
    <div class="card-head">
      <a class="card-title" href="<%= interactive ? '/o/' + o.id : o.url %>" <%- interactive ? '' : 'rel="noopener" target="_blank"' %>><%= o.title %></a>
      <% if (interactive) { %>
        <div class="actions">
          <button class="icon star" data-action="starred" aria-pressed="<%= o.starred ? 'true' : 'false' %>" title="Shortlist" aria-label="Shortlist">★</button>
          <button class="icon hide" data-action="hidden" aria-pressed="<%= o.hidden ? 'true' : 'false' %>" title="Hide" aria-label="Hide">✕</button>
        </div>
      <% } %>
    </div>
    <div class="meta">
      <span class="tag <%= o.type %>"><%= o.type %></span>
      <% if (o.stage && typeof STAGE_LABELS !== 'undefined') { %><span class="tag stage"><%= STAGE_LABELS[o.stage] %></span><% } %>
      <% if (o.funder) { %><span class="buyer"><%= o.funder %></span><% } %>
      <span><%= sourceNames[o.source_key] || o.source_key %></span>
      <% if (fmt.value(o)) { %><span class="value"><%= fmt.value(o) %></span><% } %>
      <% if (o.closes_at) { %><span class="deadline <%= fmt.soon(o.closes_at) ? 'soon' : '' %>">Closes <%= fmt.date(o.closes_at) %> · <%= fmt.daysLeft(o.closes_at) %></span><% } %>
    </div>
    <% if (o.summary) { %><p class="summary"><%= o.summary.length > 260 ? o.summary.slice(0, 257) + '…' : o.summary %></p><% } %>
    <% if (o.match.reasons.length) { %><ul class="reasons"><% o.match.reasons.forEach(r => { %><li><%= r %></li><% }) %></ul><% } %>
  </div>
</article>

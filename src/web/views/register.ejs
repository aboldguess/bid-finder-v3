<%- include('partials/head', { title: 'Create your account' }) %>
<section class="narrow panel">
  <h1><%= invite ? 'Join ' + invite.org_name : 'Create your account' %></h1>
  <% if (first) { %><p class="muted">This is the first account on this server, so it will be the administrator.</p><% } %>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <form method="post" action="<%= inviteToken ? '/invite/' + inviteToken : '/register' %>" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Your name <input name="name" required value="<%= form.name || '' %>" autocomplete="name"></label>
    <label>Work email <input type="email" name="email" required value="<%= form.email || '' %>" autocomplete="email"></label>
    <label>Password <input type="password" name="password" required minlength="10" autocomplete="new-password"><small>At least 10 characters.</small></label>
    <% if (!invite) { %><label>Company name <input name="orgName" required value="<%= form.orgName || '' %>" autocomplete="organization"></label><% } %>
    <% if (hosted) { %><label class="check"><input type="checkbox" name="terms" value="1" required <%= form.terms ? 'checked' : '' %>> <span>I agree to the <a href="/terms" target="_blank">terms of service</a> and have read the <a href="/privacy" target="_blank">privacy notice</a>.</span></label><% } %>
    <button class="button">Create account</button>
  </form>
  <p class="muted">Already have an account? <a href="/login">Sign in</a></p>
</section>
<%- include('partials/foot') %>

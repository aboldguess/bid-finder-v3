<%- include('partials/head', { title, description: title + ' for Bid Finder.' }) %>
<section class="narrow panel legal">
  <h1><%= title %></h1>
  <% if (html) { %>
    <% if (updated) { %><p class="muted">Last updated <%= fmt.date(updated) %></p><% } %>
    <%- html %>
  <% } else { %>
    <p><%= placeholder %></p>
    <p class="muted">Questions in the meantime? <%= locals.supportEmail ? '' : 'Reply to any email from us.' %><% if (locals.supportEmail) { %>Email <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a>.<% } %></p>
  <% } %>
</section>
<%- include('partials/foot') %>

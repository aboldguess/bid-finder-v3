# Bid Finder settings for the Pi, read by the bidfinder-web, bidfinder-worker and
# bidfinder-backup services. install.sh copies this to /etc/bidfinder.env (readable
# only by root and the service user) and fills in the domain, port and secrets.
# Edit with: sudo nano /etc/bidfinder.env
# Apply with: sudo systemctl restart bidfinder-web bidfinder-worker
# Every other setting is described in .env.example.

NODE_ENV=production
HOSTED=true
BASE_URL=https://@DOMAIN@
# Localhost only: the Cloudflare Tunnel reaches it from the Pi itself, nothing else can.
HOST=127.0.0.1
PORT=@PORT@
DATA_DIR=/var/lib/bidfinder
TZ=Europe/London

# The visitor's real address, for rate limits and logs. cloudflared on this Pi
# is the only trusted proxy, so nobody can forge it.
TRUST_PROXY=loopback
CLIENT_IP_HEADER=CF-Connecting-IP

# Generated by install.sh. Keep a copy somewhere safe, apart from the backups:
# BIDFINDER_SECRET_KEY encrypts stored portal logins and API keys.
SESSION_SECRET=@SESSION_SECRET@
BIDFINDER_SECRET_KEY=@SECRET_KEY@
METRICS_TOKEN=@METRICS_TOKEN@

# ---- email: written by deploy/pi/setup-mail.js (Resend) ----
# SMTP_URL=smtps://resend:re_...@smtp.resend.com:465
# MAIL_FROM=Bid Finder <alerts@@DOMAIN@>

# ---- card payments (see docs/OPERATIONS.md) ----
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_TAX=true

# ---- backups (deploy/pi/backup.sh) ----
# Nightly copies kept on the Pi.
BACKUPS_TO_KEEP=14
# Optional offsite copy with rclone, e.g. gdrive:bidfinder-backups (see deploy/pi/README.md).
BACKUP_RCLONE_REMOTE=
# Days of offsite copies to keep.
BACKUP_OFFSITE_DAYS=60
# Optional Healthchecks.io ping URL: it emails you if a night's backup doesn't happen.
BACKUP_PING_URL=

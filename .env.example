# All optional. Copy to .env (the systemd unit reads it) and uncomment what you need.
# PORT=3000
# BASE_URL=https://bids.example.co.uk      # used for links in emails
# SECURE_COOKIES=true                      # set when serving over HTTPS
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=Bid Finder <alerts@example.co.uk>
# INGEST_CRON=30 5 * * *                   # fetch sources daily at 05:30
# DIGEST_CRON=0 7 * * *                    # send digests at 07:00
# MAX_PAGES_PER_SOURCE=30

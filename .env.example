# Every setting is optional when running with `bidfinder serve`. Copy this to
# .env and uncomment what you need. For Docker, ./scripts/setup.sh writes .env.

# --- Where it runs ---
# PORT=3000                     # if busy, the next free port is used (see --strict-port)
# HOST=0.0.0.0                  # 0.0.0.0 = reachable on your network, 127.0.0.1 = this machine only
# BASE_URL=https://bids.example.co.uk   # used for links in emails and alerts; https turns on secure cookies
# DATA_DIR=./data               # database, backups and generated secrets

# --- Docker Compose with automatic HTTPS ---
# DOMAIN=bids.example.co.uk     # must point at the server; BASE_URL is derived from it

# --- Secrets (generated into DATA_DIR on first run if unset) ---
# SESSION_SECRET=
# BIDFINDER_SECRET_KEY=         # encrypts stored portal logins, API keys and webhooks
# METRICS_TOKEN=                # bearer token for /metrics; without it only private addresses may read it

# --- Email ---
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=Bid Finder <alerts@example.co.uk>

# --- Card payments (hosted mode, see docs/OPERATIONS.md) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...  # from the webhook endpoint for https://<your domain>/stripe/webhook
# STRIPE_TAX=false                 # true: Stripe Tax adds UK VAT (set it up in Stripe first)

# --- Behaviour ---
# HOSTED=false                  # true runs a shared service: open sign-up with a terms tick (same as serve --hosted)
# ALLOW_REGISTRATION=false      # true lets anyone create an organisation; otherwise invite only
# SIGNUP_MIN_SECONDS=3          # sign-up forms sent faster than this after showing are treated as bots
# DISABLE_SCHEDULER=false       # true serves the web app without fetching sources
# DIGEST_CRON=0 7 * * *         # when digests are sent
# MAINTENANCE_CRON=15 3 * * *   # nightly clean-up and backup
# TZ=Europe/London
# MAX_PAGES_PER_SOURCE=40
# RETENTION_DAYS=180            # closed opportunities nobody triaged are removed after this
# BACKUPS_TO_KEEP=7
# TRUST_PROXY=loopback          # which proxies may set X-Forwarded-For
# USER_AGENT=                   # sent to portals; defaults to BidFinder/<version> (+BASE_URL)
# LOG_FORMAT=text               # or json (the default when NODE_ENV=production)
# LOG_LEVEL=info
